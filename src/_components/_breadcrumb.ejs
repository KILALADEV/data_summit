<%_
/**
 * breadcrumb
 * @description: Component thanh điều hướng đường dẫn
 */
let data = {
  items: [] // Mảng chứa { label: '...', link: '...' }
}
if (typeof props !== 'undefined') {
  data.items = typeof props.items !== 'undefined' ? props.items : data.items;
}
_%>

<% if (data.items && data.items.length > 0) { %>
  <nav class="c-breadcrumb" aria-label="Breadcrumb">
    <ol class="c-breadcrumb__list">
      <% data.items.forEach(function(item, index) { %>
        <li class="c-breadcrumb__item">
          <% if (item.link && index < data.items.length - 1) { %>
            <a href="<%= item.link %>" class="c-breadcrumb__link"><%= item.label %></a>
          <% } else { %>
            <span class="c-breadcrumb__current" aria-current="page"><%= item.label %></span>
          <% } %>
        </li>
      <% }); %>
    </ol>
  </nav>
<% } %>
