<%_
/**
 * pagination
 * @description: Component pagination
 */
let data = {
  currentPage: 1,
  totalPages: 1,
  baseUrl: '?page='
}
if (typeof props !== 'undefined') {
  data.currentPage = typeof props.currentPage !== 'undefined' ? parseInt(props.currentPage) : data.currentPage;
  data.totalPages = typeof props.totalPages !== 'undefined' ? parseInt(props.totalPages) : data.totalPages;
  data.baseUrl = typeof props.baseUrl !== 'undefined' ? props.baseUrl : data.baseUrl;
}
_%>

<% if (data.totalPages > 1) { %>
  <nav class="c-pagination" aria-label="ページネーション">
    <% if (data.currentPage === 1) { %>
      <span class="c-pagination__btn c-pagination__btn--prev is-disabled" aria-disabled="true">
        前へ
      </span>
    <% } else { %>
      <a href="<%= data.baseUrl %><%= data.currentPage - 1 %>"
         class="c-pagination__btn c-pagination__btn--prev"
         aria-label="前のページへ">
        前へ
      </a>
    <% } %>
    <ul class="c-pagination__list">
      <% for(let i = 1; i <= data.totalPages; i++) { %>
        <li class="c-pagination__item">
          <% if (i === data.currentPage) { %>
            <span class="c-pagination__link is-active" aria-current="page">
              <%= i %>
            </span>
          <% } else { %>
            <a href="<%= data.baseUrl %><%= i %>"
               class="c-pagination__link"
               aria-label="<%= i %>ページ目へ">
              <%= i %>
            </a>
          <% } %>
        </li>
      <% } %>
    </ul>

    <% if (data.currentPage === data.totalPages) { %>
      <span class="c-pagination__btn c-pagination__btn--next is-disabled" aria-disabled="true">
        次へ
      </span>
    <% } else { %>
      <a href="<%= data.baseUrl %><%= data.currentPage + 1 %>"
         class="c-pagination__btn c-pagination__btn--next"
         aria-label="次のページへ">
        次へ
      </a>
    <% } %>

  </nav>
<% } %>
