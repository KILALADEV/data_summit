<%_
/**
 * card
 * @description: Component Card
 */
let data = {
  image: '',
  badge: '',
  title: '',
  description: '',
  link: '',
  target: '_self',
  buttonLabel: ''
}

if (typeof props !== 'undefined') {
  data.image = typeof props.image !== 'undefined' ? props.image : data.image;
  data.badge = typeof props.badge !== 'undefined' ? props.badge : data.badge;
  data.title = typeof props.title !== 'undefined' ? props.title : data.title;
  data.description = typeof props.description !== 'undefined' ? props.description : data.description;
  data.link = typeof props.link !== 'undefined' ? props.link : data.link;
  data.target = typeof props.target !== 'undefined' ? props.target : data.target;
  data.buttonLabel = typeof props.buttonLabel !== 'undefined' ? props.buttonLabel : data.buttonLabel;
}

let isExternalLink = false;
if (data.link) {
  isExternalLink = /^https?:\/\//i.test(data.link) || /^\/\//.test(data.link);
}

let relAttribute = '';
if (data.target === '_blank') {
  relAttribute = 'rel="noopener noreferrer"';
} else if (isExternalLink) {
  relAttribute = 'rel="noopener"';
}
_%>

<article class="c-card <%= data.link ? 'c-card--clickable' : '' %>">
  <% if (data.image) { %>
    <figure class="c-card__thumb">
      <img src="<%= data.image %>" alt="" class="c-card__image" loading="lazy" aria-hidden="true">
      <% if (data.badge) { %>
        <span class="c-card__badge"><%= data.badge %></span>
      <% } %>
    </figure>
  <% } %>
  <div class="c-card__content">
    <% if (data.title) { %>
      <h3 class="c-card__title">
        <% if (data.link) { %>
          <a href="<%= data.link %>" target="<%= data.target %>" <%- relAttribute %> class="c-card__link">
            <%= data.title %>
          </a>
        <% } else { %>
          <%= data.title %>
        <% } %>
      </h3>
    <% } %>

    <% if (data.description) { %>
      <p class="c-card__description">
        <%= data.description %>
      </p>
    <% } %>

    <% if (data.buttonLabel) { %>
      <div class="c-card__action" aria-hidden="true">
        <%- include('button', {
          props: {
            label: data.buttonLabel,
            link: data.link,
            target: data.target,
            attributes: `tabindex="-1" ${relAttribute}`
          }
        }) %>
      </div>
    <% } %>
  </div>
</article>
