<%_
/**
 * list
 * @description: Component danh sách
 */
let data = {
  tag: 'ul',      // Mặc định là 'ul' (không thứ tự). Có thể đổi thành 'ol' (có thứ tự)
  items: []       // Mảng chứa các phần tử (có thể là chuỗi text hoặc chứa mã HTML)
}

if (typeof props !== 'undefined') {
  data.tag = typeof props.tag !== 'undefined' ? props.tag : data.tag;
  data.items = typeof props.items !== 'undefined' ? props.items : data.items;
}
_%>

<% if (data.items && data.items.length > 0) { %>
  <<%= data.tag %> class="c-list" role="list">
    <% data.items.forEach(function(item) { %>
      <li class="c-list__item" role="listitem">
        <%- item %>
      </li>
    <% }); %>
  </<%= data.tag %>>
<% } %>
