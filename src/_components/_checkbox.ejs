<%_
/**
 * checkbox
 * @description: Component Checkbox
 */
let data = {
  id: 'chk-' + Math.random().toString(36).substring(2, 9), // Tự động tạo ID nếu dev quên truyền
  name: '',
  label: '',
  size: '',         // ví dụ: 'sm', 'lg'
  checked: false,   // Trạng thái tích chọn mặc định
  disabled: false,  // Trạng thái vô hiệu hóa
  required: false   // Trạng thái bắt buộc điền
}

if (typeof props !== 'undefined') {
  data.id = typeof props.id !== 'undefined' ? props.id : data.id;
  data.name = typeof props.name !== 'undefined' ? props.name : data.name;
  data.label = typeof props.label !== 'undefined' ? props.label : data.label;
  data.size = typeof props.size !== 'undefined' ? props.size : data.size;
  data.checked = typeof props.checked !== 'undefined' ? props.checked : data.checked;
  data.disabled = typeof props.disabled !== 'undefined' ? props.disabled : data.disabled;
  data.required = typeof props.required !== 'undefined' ? props.required : data.required;
}
_%>

<label class="c-checkbox <%= data.disabled ? 'is-disabled' : '' %>" for="<%= data.id %>">
  <input
    type="checkbox"
    name="<%= data.name %>"
    id="<%= data.id %>"
    class="c-checkbox__input <%- data.size ? `c-checkbox__input--${data.size}` : '' %>"
    <% if (data.checked) { %> checked <% } %>
    <% if (data.disabled) { %> disabled <% } %>
    <% if (data.required) { %> aria-required="true" required <% } %>
  >

  <span class="c-checkbox__label">
    <%= data.label %>
    <% if (data.required) { %>
      <span class="c-checkbox__required" aria-hidden="true">*</span>
    <% } %>
  </span>
</label>
