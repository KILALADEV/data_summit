<%_
/**
 * modal
 * @description: Component Modal
 */
let data = {
  id: 'modal-' + Math.random().toString(36).substring(2, 9),
  title: '',
  body: '',
  size: 'normal' // 'small', 'normal', 'large'
}

if (typeof props !== 'undefined') {
  data.id = typeof props.id !== 'undefined' ? props.id : data.id;
  data.title = typeof props.title !== 'undefined' ? props.title : data.title;
  data.body = typeof props.body !== 'undefined' ? props.body : data.body;
  data.size = typeof props.size !== 'undefined' ? props.size : data.size;
}

let titleId = `title-${data.id}`;
_%>

<dialog
  id="<%= data.id %>"
  class="c-modal c-modal--<%= data.size %>"
  aria-labelledby="<%= titleId %>"
>
  <div class="c-modal__container">

    <div class="c-modal__header">
      <h2 id="<%= titleId %>" class="c-modal__title">
        <%= data.title %>
      </h2>

      <button type="button" class="c-modal__close" aria-label="ダイアログを閉じる" data-close>
        <span aria-hidden="true">&times;</span>
      </button>
    </div>

    <div class="c-modal__body">
      <%- data.body %>
    </div>

  </div>
</dialog>
