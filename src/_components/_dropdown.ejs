<%_
/**
 * dropdown
 * @description: Dropdownコンポーネント
 */
let data = {
  label: '',
  name: 'dropdown',
  id: 'dropdown-' + Math.random().toString(36).substring(2, 9), // Tạo ID ngẫu nhiên nếu dev quên truyền để tránh trùng ID trên trang
  full: false,
  placeholder: '', // Thêm tùy chọn chữ hiển thị mặc định (ví dụ: "選択してください")
  required: false,  // Trạng thái bắt buộc chọn
  disabled: false,  // Trạng thái vô hiệu hóa
  list: [
    { text: 'ドロップダウン1', value: 'dropdown1' },
    { text: 'ドロップダウン2', value: 'dropdown2' },
    { text: 'ドロップダウン3', value: 'dropdown3' },
  ],
}

if (typeof props !== 'undefined') {
  data.label = typeof props.label !== 'undefined' ? props.label : data.label;
  data.name = typeof props.name !== 'undefined' ? props.name : data.name;
  data.id = typeof props.id !== 'undefined' ? props.id : data.id;
  data.full = typeof props.full !== 'undefined' ? props.full : data.full;
  data.placeholder = typeof props.placeholder !== 'undefined' ? props.placeholder : data.placeholder;
  data.required = typeof props.required !== 'undefined' ? props.required : data.required;
  data.disabled = typeof props.disabled !== 'undefined' ? props.disabled : data.disabled;
  data.list = typeof props.list !== 'undefined' ? props.list : data.list;
}
_%>

<div class="c-dropdown <%= data.full ? 'c-dropdown--full' : '' %> <%= data.disabled ? 'is-disabled' : '' %>">
  <% if (data.label) { %>
    <label for="<%= data.id %>" class="c-dropdown__label">
      <%= data.label %>
      <% if (data.required) { %>
        <span class="c-dropdown__required" aria-hidden="true">*</span>
      <% } %>
    </label>
  <% } %>

  <div class="c-dropdown__select-wrapper">
    <select
      name="<%= data.name %>"
      id="<%= data.id %>"
      class="c-dropdown__select"
      <% if (data.required) { %> required aria-required="true" <% } %>
      <% if (data.disabled) { %> disabled <% } %>
    >
      <% if (data.placeholder) { %>
        <option value="" disabled selected><%= data.placeholder %></option>
      <% } %>

      <% data.list.forEach((item) => { %>
        <option value="<%= item.value %>"><%= item.text %></option>
      <% }) %>
    </select>

    <span class="c-dropdown__icon" aria-hidden="true"></span>
  </div>

</div>
