<%_
/**
 * image
 * @description: Imageコンポーネント
 */
let data = {
  src: '',
  alt:'',
  caption:'',
  width: '',
  height: '',
  type: '', // picture, figure, image, caption
  class: '',
  list: [
    {
      media: '',
      srcset: '',
      type: 'image/jpg',
    },
    {
      media: '',
      srcset: '',
      type: 'image/jpg',
    }
  ]
}
data.src = typeof props !== 'undefined' && typeof props.src !== 'undefined' ? props.src : data.src
data.alt = typeof props !== 'undefined' && typeof props.alt !== 'undefined' ? props.alt : data.alt
data.caption = typeof props !== 'undefined' && typeof props.caption !== 'undefined' ? props.caption : data.caption
data.width = typeof props !== 'undefined' && typeof props.width !== 'undefined' ? props.width : data.width
data.height = typeof props !== 'undefined' && typeof props.height !== 'undefined' ? props.height : data.height
data.type = typeof props !== 'undefined' && typeof props.type !== 'undefined' ? props.type : data.type
data.class = typeof props !== 'undefined' && typeof props.class !== 'undefined' ? props.class : data.class
data.list = typeof props !== 'undefined' && typeof props.list !== 'undefined' ? props.list : data.list
_%>
  <%_ if(data.type === 'caption') { _%>
  <figure class="c-image__figure <%= data.class %>">
    <img src="<%= data.src %>" alt="<%= data.alt %>" width="<%= data.width %>" height="<%= data.height %>" class="c-image" />
    <figcaption class="c-image__caption"><%= data.caption %></figcaption>
  </figure>
  <%_ } else if(data.type === 'picture') { _%>
  <picture class="c-image__picture <%= data.class %>">
    <% data.list.forEach((item) => { %>
      <source srcset="<%= item.srcset %>" <%- item.media ? `media="${item.media}"` : '' %> <%- item.type ? `type="${item.type}"` : '' %> />
    <% }) %>
    <img src="<%= data.src %>" alt="<%= data.alt %>" width="<%= data.width %>" height="<%= data.height %>" class="c-image" />
  </picture>
  <%_ } else if(data.type === 'figure') { _%>
  <picture class="c-image__picture <%= data.class %>">
    <% data.list.forEach((item) => { %>
      <source srcset="<%= item.srcset %>" <%- item.media ? `media="${item.media}"` : '' %> <%- item.type ? `type="${item.type}"` : '' %> />
    <% }) %>
    <img src="<%= data.src %>" alt="<%= data.alt %>" width="<%= data.width %>" height="<%= data.height %>" class="c-image" />
  </picture>
  <%_ } else { _%>
  <img src="<%= data.src %>" alt="<%= data.alt %>" width="<%= data.width %>" height="<%= data.height %>" class="c-image <%= data.class %>" />
  <%_ } _%>

if (typeof props !== 'undefined') {
  data.src = typeof props.src !== 'undefined' ? props.src : data.src;
  data.alt = typeof props.alt !== 'undefined' ? props.alt : data.alt;
  data.caption = typeof props.caption !== 'undefined' ? props.caption : data.caption;
  data.width = typeof props.width !== 'undefined' ? props.width : data.width;
  data.height = typeof props.height !== 'undefined' ? props.height : data.height;
  data.type = typeof props.type !== 'undefined' ? props.type : data.type;
  data.lazy = typeof props.lazy !== 'undefined' ? props.lazy : data.lazy;
  data.list = typeof props.list !== 'undefined' ? props.list : data.list;
}

let imgAttributes = [];
if (data.width) imgAttributes.push(`width="${data.width}"`);
if (data.height) imgAttributes.push(`height="${data.height}"`);
if (data.lazy) {
  imgAttributes.push('loading="lazy"');
} else {
  // Nếu không lazy load (ảnh quan trọng), thêm fetchpriority="high" để ép trình duyệt tải sớm nhất
  imgAttributes.push('fetchpriority="high"');
}
// Giúp trình duyệt giải mã hình ảnh song song, không làm block quá trình render UI
imgAttributes.push('decoding="async"');
_%>

<%_ if (data.type === 'caption') { _%>
  <figure class="c-image__figure">
    <img src="<%= data.src %>" alt="<%= data.alt %>" class="c-image" <%- imgAttributes.join(' ') %> />
    <% if (data.caption) { %>
      <figcaption class="c-image__caption"><%= data.caption %></figcaption>
    <% } %>
  </figure>

<%_ } else if (data.type === 'picture') { _%>
  <picture class="c-image__picture">
    <% data.list.forEach((item) => { %>
      <source
        srcset="<%= item.srcset %>"
        <%- item.media ? `media="${item.media}"` : '' %>
        <%- item.type ? `type="${item.type}"` : '' %>
        <%- item.width ? `width="${item.width}"` : '' %>
        <%- item.height ? `height="${item.height}"` : '' %>
      />
    <% }) %>
    <img src="<%= data.src %>" alt="<%= data.alt %>" class="c-image" <%- imgAttributes.join(' ') %> />
  </picture>

<%_ } else if (data.type === 'responsive-figure') { _%>
  <figure class="c-image__figure">
    <picture class="c-image__picture">
      <% data.list.forEach((item) => { %>
        <source
          srcset="<%= item.srcset %>"
          <%- item.media ? `media="${item.media}"` : '' %>
          <%- item.type ? `type="${item.type}"` : '' %>
          <%- item.width ? `width="${item.width}"` : '' %>
          <%- item.height ? `height="${item.height}"` : '' %>
        />
      <% }) %>
      <img src="<%= data.src %>" alt="<%= data.alt %>" class="c-image" <%- imgAttributes.join(' ') %> />
    </picture>
    <% if (data.caption) { %>
      <figcaption class="c-image__caption"><%= data.caption %></figcaption>
    <% } %>
  </figure>

<%_ } else { _%>
  <img src="<%= data.src %>" alt="<%= data.alt %>" class="c-image" <%- imgAttributes.join(' ') %> />
<%_ } _%>
