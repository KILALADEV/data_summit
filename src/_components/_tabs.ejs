<%_
/**
 * tabs
 * @description: Component tabs
 */
let data = {
  id: 'tabs-' + Math.random().toString(36).substring(2, 9),
  items: [] // Mảng chứa { title: '...', content: '...' }
}
if (typeof props !== 'undefined') {
  data.items = typeof props.items !== 'undefined' ? props.items : data.items;
}
_%>

<% if (data.items && data.items.length > 0) { %>
  <div class="c-tabs" id="<%= data.id %>">

    <ul class="c-tabs__nav" role="tablist" aria-label="コンテンツ切り替えタブ">
      <% data.items.forEach(function(item, index) {
        let tabId = `${data.id}-tab-${index}`;
        let panelId = `${data.id}-panel-${index}`;
        let isActive = (index === 0);
      %>
        <li class="c-tabs__nav-item" role="presentation">
          <button
            id="<%= tabId %>"
            class="c-tabs__trigger <%= isActive ? 'is-active' : '' %>"
            type="button"
            role="tab"
            aria-selected="<%= isActive ? 'true' : 'false' %>"
            aria-controls="<%= panelId %>"
            <% if (!isActive) { %> tabindex="-1" <% } %>
          >
            <%= item.title %>
          </button>
        </li>
      <% }); %>
    </ul>

    <div class="c-tabs__content">
      <% data.items.forEach(function(item, index) {
        let tabId = `${data.id}-tab-${index}`;
        let panelId = `${data.id}-panel-${index}`;
        let isActive = (index === 0);
      %>
        <div
          id="<%= panelId %>"
          class="c-tabs__panel <%= isActive ? 'is-active' : '' %>"
          role="tabpanel"
          aria-labelledby="<%= tabId %>"
          tabindex="0"
          <%= !isActive ? 'hidden' : '' %>
        >
          <%- item.content %>
        </div>
      <% }); %>
    </div>

  </div>
<% } %>
