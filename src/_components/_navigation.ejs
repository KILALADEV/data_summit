<%_
/**
 * navigation
 * @description: Component Navigation
 */
let data = {
  menuItems: [] // Mảng dạng: { label: '...', link: '...', target: '_self', submenu: [...] }
}

if (typeof props !== 'undefined') {
  data.menuItems = typeof props.menuItems !== 'undefined' ? props.menuItems : data.menuItems;
}

const getRelAttribute = (link, target) => {
  if (!link) return '';
  let isExternal = /^https?:\/\//i.test(link) || /^\/\//.test(link);
  if (target === '_blank') return 'rel="noopener noreferrer"';
  if (isExternal) return 'rel="noopener"';
  return '';
};
_%>

<% if (data.menuItems && data.menuItems.length > 0) { %>
  <nav class="c-nav" aria-label="メインナビゲーション">
    <ul class="c-nav__list">
      <% data.menuItems.forEach(function(item, index) { %>
        <% let hasSub=item.submenu && item.submenu.length> 0;
          let itemTarget = item.target || '_self';
          let itemRel = getRelAttribute(item.link, itemTarget);
          let dropdownId = `nav-dropdown-${index}`;
          %>
          <li class="c-nav__item <%= hasSub ? 'c-nav__item--has-dropdown' : '' %>">
            <a href="<%= item.link || '#' %>" class="c-nav__link" target="<%= itemTarget %>" <%- itemRel %>
              >
              <%= item.label %>
            </a>
            <% if (hasSub) { %>
              <button type="button" class="c-nav__toggle" aria-expanded="false" aria-controls="<%= dropdownId %>"
                aria-label="<%= item.label %>のサブメニューを開く">
              </button>
              <ul id="<%= dropdownId %>" class="c-nav__dropdown" hidden>
                <% item.submenu.forEach(function(subItem) { %>
                  <% let subTarget=subItem.target || '_self' ; let subRel=getRelAttribute(subItem.link, subTarget); %>
                    <li class="c-nav__dropdown-item">
                      <a href="<%= subItem.link %>" class="c-nav__dropdown-link" target="<%= subTarget %>" <%- subRel %>
                        >
                        <%= subItem.label %>
                      </a>
                    </li>
                  <% }); %>
              </ul>
              <% } %>
          </li>
          <% }); %>
    </ul>
  </nav>
<% } %>
