<%_
/**
 * description-list
 * @description: Component danh sách mô tả (dl, dt, dd)
 */
let data = {
  items: []
}

if (typeof props !== 'undefined') {
  data.items = typeof props.items !== 'undefined' ? props.items : data.items;
}
_%>

<% if (data.items && data.items.length > 0) { %>
  <dl class="c-dl">
    <% data.items.forEach(function(item) { %>
      <dt class="c-dl__term"><%= item.term %></dt>
      <dd class="c-dl__desc"><%= item.description %></dd>
    <% }); %>
  </dl>
<% } %>
