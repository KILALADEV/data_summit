<section id="timetable" class="top-timetable">
  <div class="container">
     <h2 class="c-title">TimeTable</h2>

  <% schedule.forEach(block => { %>
    <p class="c-divider-block">
      <span class="c-divider-title"><%= block.timeBlock %></span>
      <span class="c-divider"></span>
    </p>

    <div class="top-col">
      <% block.cards.forEach(card => { %>
        <div class="top-col__item">
          <div class="c-card">
          <p class="c-card__time">
            <%= card.time %>
            <span class="c-card__lable"><%= card.label %></span>
          </p>
          <p class="c-card__category"><%= card.category %></p>
          <h3 class="c-card__title">
            <a href="#" class="c-card__link"><%- card.title %></a>
          </h3>

          <div class="c-card__detail">
            <% card.speakers.forEach(speaker => { %>
              <p class="c-card__subtitle"><%= speaker.name %></p>
              <p class="c-card__lead"><%= speaker.company %></p>
              <p class="c-card__text"><%= speaker.role %></p>
            <% }); %>

            <div class="c-card__gallery">
              <% card.gallery.forEach(imgSrc => { %>
                <img class="c-image" src="<%= imgSrc %>" alt="" width="176" height="212">
              <% }); %>
            </div>

            <ul class="c-card__company">
              <% card.companies.forEach(item => { %>
                <li><img class="c-image" src="<%= item.src %>" alt="<%= item.alt %>" width="152" height="152"></li>
              <% }); %>
            </ul>
          </div>

          <a href="#" class="c-card__modal">
            <img src="/assets/images/icon-plus.png" alt="open modal" width="80" height="80">
          </a>
        </div>
        </div>
      <% }); %>
    </div>
  <% }); %>
  </div>
</section>

<%
  const faqs = [
    {
      q: "オンライン配信はありますか？",
      a: "いいえ、オフライン限定開催です。10月15日に寺田倉庫にご来場いただいた方のみ、ご参加いただけます。"
    },
    {
      q: "参加費はかかりますか？",
      a: "無料でご参加いただけます。"
    },
    {
      q: "当日の持ち物はありますか？",
      a: "受付用のQRコードとお名刺を2枚ご用意ください。"
    }
  ];
%>

<section id="faq" class="top-faq">
  <div class="container">
    <h2 class="c-title">FAQ</h2>

    <dl class="c-accordion" data-accordion-group>
      <% faqs.forEach((faq, index) => {
        const buttonId = `faq-btn-${index + 1}`;
        const panelId = `faq-panel-${index + 1}`;
      %>
        <dt class="c-accordion__heading">
          <button id="<%= buttonId %>" class="c-accordion__button" type="button" aria-expanded="false" aria-controls="<%= panelId %>">
            <span class="c-accordion__title">
              <%- faq.q %>
            </span>
          </button>
        </dt>

        <dd id="<%= panelId %>" class="c-accordion__panel" aria-labelledby="<%= buttonId %>" hidden>
          <div class="c-accordion__content">
            <%- faq.a %>
          </div>
        </dd>
      <% }); %>
    </dl>
  </div>
</section>
