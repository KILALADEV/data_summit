<%
  class ButtonComponent {
    constructor(props = {}) {
      this.isVisible = props.isVisible !== false;
      this.text = props.text || 'Click here';
      this.url = props.url || '#';
      this.id = props.id || '';
      this.className = props.className || 'btn-default';
      this.target = props.target || '_self';

      this.iconClass = props.icon || '';
      this.iconPosition = props.iconPosition || 'left';

      this.rel = this.target === '_blank' ? 'rel="noopener noreferrer"' : '';
    }

    shouldRender() {
      return this.isVisible;
    }

    hasIcon() {
      return String(this.iconClass).trim() !== '';
    }

    needsSpanWrapper() {
      return this.target === '_blank' || this.hasIcon();
    }

    // Mẹo OOP: Tạo class modifier cho thẻ text cha dựa vào vị trí của icon
    getTextModifierClass() {
      if (!this.hasIcon()) return '';
      return `c-btn__text-${this.iconPosition}`;
    }
  }

  const button = new ButtonComponent(locals.props);
%>

<% if (button.shouldRender()) { %>
  <div class="component-button-wrapper">
    <a href="<%= button.url %>"
       <% if (button.id) { %> id="<%= button.id %>" <% } %>
       class="btn <%= button.className %>"
       target="<%= button.target %>"
       <%- button.rel %>>

      <% if (button.needsSpanWrapper()) { %>
        <span class="c-btn__text <%= button.hasIcon() ? '' : '' %> <%= button.getTextModifierClass() %>">

          <% if (button.hasIcon() && button.iconPosition === 'left') { %>
            <span class="c-btn__icon <%= button.iconClass %>"></span>
          <% } %>

          <%= button.text %>

          <% if (button.hasIcon() && button.iconPosition === 'right') { %>
            <span class="c-btn__icon <%= button.iconClass %>"></span>
          <% } %>

        </span>
      <% } else { %>
        <%= button.text %>
      <% } %>
    </a>
  </div>
<% } %>
