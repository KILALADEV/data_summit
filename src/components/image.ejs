<%
  class ImageComponent {
    constructor(props = {}) {
      this.src = props.src || ''; // Đường dẫn ảnh mặc định (hoặc ảnh Desktop)
      this.alt = props.alt || 'Image';
      this.className = props.className || '';
      this.id = props.id || '';

      // HỖ TRỢ RESPONSIVE (Ảnh riêng cho thiết bị di động, nếu có)
      this.mobileSrc = props.mobileSrc || '';
      this.breakpoint = props.breakpoint || '768px'; // Ngưỡng chuyển đổi mobile/desktop

      // TỐI ƯU HÓA TỐC ĐỘ (Mặc định là lazy load, trừ phi đặt eager cho banner đầu trang)
      this.loading = props.loading || 'lazy';
      this.decoding = props.decoding || 'async';

      // CHỐNG GIẬT KHUNG LAYOUT (Aspect Ratio - Ví dụ: "16/9", "4/3", "1/1")
      this.aspectRatio = props.aspectRatio || '';
    }

    // Kiểm tra xem đường dẫn ảnh có hợp lệ không
    hasSrc() {
      return String(this.src).trim() !== '';
    }

    // Kiểm tra xem có cấu hình ảnh riêng cho mobile không
    hasMobileSrc() {
      return String(this.mobileSrc).trim() !== '';
    }

    // Tự động sinh style inline để giữ vững tỉ lệ khung hình nếu có khai báo aspectRatio
    getWrapperStyle() {
      if (!this.aspectRatio) return '';
      return `style="aspect-ratio: ${this.aspectRatio}; overflow: hidden; display: block;"`;
    }
  }

  const image = new ImageComponent(locals.props);
%>

<% if (image.hasSrc()) { %>
  <div class="component-image-wrapper" <%- image.getWrapperStyle() %>>
    <picture>

      <% if (image.hasMobileSrc()) { %>
        <source media="(max-width: <%= image.breakpoint %>)" srcset="<%= image.mobileSrc %>">
      <% } %>

      <img src="<%= image.src %>"
           <% if (image.id) { %> id="<%= image.id %>" <% } %>
           class="c-image <%= image.className %>"
           alt="<%= image.alt %>"
           loading="<%= image.loading %>"
           decoding="<%= image.decoding %>"/>

    </picture>
  </div>
<% } else { %>
  <% console.warn("Warning: Image component render thất bại do thiếu thuộc tính 'src'!"); %>
<% } %>
